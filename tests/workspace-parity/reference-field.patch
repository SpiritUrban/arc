diff --git a/tests/workspace-parity/workspace.spec.mjs b/tests/workspace-parity/workspace.spec.mjs
index 832275d..c8d4e0d 100644
--- a/tests/workspace-parity/workspace.spec.mjs
+++ b/tests/workspace-parity/workspace.spec.mjs
@@ -435,0 +436,31 @@ test("ORD-04–06 · ownership, detail update and independent cancellation", asy
+
+test("reference experiment · order field survives create, edit and reads", async ({ page, request }, info) => {
+  const { user } = await fixture(request, info, "Reference", []);
+  const invalid = await request.post(orderPath(info), {
+    headers: auth(user.id),
+    data: { product: "Картка", quantity: 2, reference: "x".repeat(25) },
+  });
+  expect(invalid.status()).toBe(400);
+  await page.goto("/orders");
+  await userRow(page, user.name).click();
+  const create = createOrderForm(page);
+  await create.locator('[name="product"]').fill("Картка");
+  await create.locator('[name="quantity"]').fill("2");
+  await create.locator('[name="reference"]').fill("CLIENT-1");
+  await create.getByRole("button", { name: /Створити/ }).click();
+  await expect(orderRow(page, "Картка")).toContainText("CLIENT-1");
+  const [saved] = await (await request.get(orderPath(info), { headers: auth(user.id) })).json();
+  expect(saved.reference).toBe("CLIENT-1");
+  await orderRow(page, "Картка").getByRole("link").click();
+  const details = orderDetail(page);
+  await expect(details.getByText("CLIENT-1", { exact: true })).toBeVisible();
+  const reference = details.locator('[name="reference"]');
+  await expect(reference).toHaveValue("CLIENT-1");
+  await reference.fill("CLIENT-2");
+  await details.getByRole("button", { name: "Зберегти зміни" }).click();
+  await expect(details.getByText("CLIENT-2", { exact: true })).toBeVisible();
+  await page.getByRole("link", { name: "← Усі замовлення" }).click();
+  await expect(orderRow(page, "Картка")).toContainText("CLIENT-2");
+  const updated = await request.get(orderPath(info, `/${saved.id}`), { headers: auth(user.id) });
+  expect((await updated.json()).reference).toBe("CLIENT-2");
+});
