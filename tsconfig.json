{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "customConditions": ["arc-source"]
  },
  "include": [
    "framework/src/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "docs/examples/**/*.ts",
    "benchmarks/**/*.ts",
    "scripts/**/*.ts"
  ]
}
