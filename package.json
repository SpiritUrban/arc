{
  "name": "arc-example",
  "private": true,
  "type": "module",
  "workspaces": [
    "framework"
  ],
  "scripts": {
    "dev": "node --conditions=arc-source --import tsx framework/src/cli.ts stand",
    "start": "node --conditions=arc-source --import tsx framework/src/cli.ts start",
    "graph": "node --conditions=arc-source --import tsx framework/src/cli.ts graph",
    "inspect": "node --conditions=arc-source --import tsx framework/src/cli.ts inspect",
    "test": "node --conditions=arc-source --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace @arc/framework && tsc",
    "test:lifecycle": "node --conditions=arc-source --import tsx --test tests/lifecycle.test.ts",
    "benchmark:scheduler": "node --conditions=arc-source --import tsx benchmarks/scheduler.ts",
    "test:distribution": "npm run build --workspace @arc/framework && node scripts/check-distribution.mjs"
  },
  "dependencies": {
    "@arc/framework": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
