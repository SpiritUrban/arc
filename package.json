{
  "name": "arc-example",
  "private": true,
  "type": "module",
  "workspaces": [
    "framework"
  ],
  "scripts": {
    "dev": "node --import tsx framework/src/cli.ts stand",
    "start": "node --import tsx framework/src/cli.ts start",
    "graph": "node --import tsx framework/src/cli.ts graph",
    "inspect": "node --import tsx framework/src/cli.ts inspect",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@arc/framework": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
