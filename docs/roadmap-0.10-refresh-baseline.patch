+  const product = "Filtered notebook";
+  const { user, rows: [order] } = await fixture(request, info, "Filtered", [[product, 2]]);
+  await page.goto("/orders");
+  await userRow(page, user.name).click();
+  const status = page.getByLabel("Статус");
+  const readActive = page.waitForRequest((req) =>
+    new URL(req.url()).pathname === transport(info, "orders.list") &&
+    req.headers().authorization === `Bearer ${user.id}` &&
+    req.postDataJSON()?.cancelled === false,
+  );
